# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Get these from https://app.alpaca.markets (paper keys) or your live account.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# true = paper trading (fake money, real market data). Keep this true until you're
# confident in the strategy. The bot also requires --live on the command line
# AND this set to false before it will touch a real account.
ALPACA_PAPER=true

# Your total real-money budget. The bot refuses to start if STAKES below adds up to more than this.
TOTAL_BUDGET=1000

# Per-symbol dollar amounts, as SYMBOL:DOLLARS pairs.
STAKES=SPY:100,QQQ:100,AAPL:100

# Strategy: trend | meanrev
STRATEGY=trend

# How often the bot checks prices and re-evaluates, in seconds.
POLL_INTERVAL_SECONDS=300
